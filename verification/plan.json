  "tests": [
    {
      "id": "foundation",
      "tier": "foundation",
      "command": [
        "node",
        "scripts/wms/foundation-check.mjs"
      ],
      "timeout": 600
    },
    {
      "id": "shared_integrity",
      "tier": "captured_evidence",
      "command": [
        "{python}",
        "ci/check_shared_core.py"
      ],
      "timeout": 600
    },
    {
      "id": "stage_gate_regressions",
      "tier": "foundation",
      "command": [
        "node",
        "--test",
        "tests/foundation/architecture-decision.test.mjs",
        "tests/foundation/gates.test.mjs"
      ],
      "timeout": 600,
      "min_executed_tests": 1
    },
    {
      "id": "authority_holds",
      "tier": "foundation",
      "command": [
        "{python}",
        "-m",
        "unittest",
        "discover",
        "-s",
        "tests/shared_core",
        "-v"
      ],
      "timeout": 600,
      "min_executed_tests": 1
    },
    {
      "id": "dependency_install",
      "tier": "dependencies",
      "command": [
        "{bun}",
        "install",
        "--frozen-lockfile",
        "--ignore-scripts"
      ],
      "timeout": 1200
    },
    {
      "id": "unit_tests",
      "tier": "unit",
      "command": [
        "{bun}",
        "run",
        "test:unit"
      ],
      "timeout": 600,
      "min_executed_tests": 1
    },
    {
      "id": "typecheck",
      "tier": "typescript",
      "command": [
        "{bun}",
        "run",
        "typecheck"
      ],
      "timeout": 600
    },
    {
      "id": "lint",
      "tier": "lint",
      "command": [
        "{bun}",
        "run",
        "lint"
      ],
      "timeout": 600
    },
    {
      "id": "build",
      "tier": "build",
      "command": [
        "{bun}",
        "run",
        "build"
      ],
      "timeout": 1200
    },
    {
      "id": "legacy_db_adapter",
      "tier": "database",
      "command": [
        "node",
        "scripts/wms/db-check.mjs"
      ],
      "timeout": 600,
      "blocked_exit_codes": [
        2
      ]
    },
    {
      "id": "alternative_gate_regressions",
      "tier": "foundation",
      "command": [
        "{python}",
        "-m",
        "unittest",
        "discover",
        "-s",
        "verification/tests",
        "-v"
      ],
      "timeout": 600,
      "min_executed_tests": 1
    },
    {
      "id": "accounting_native_link",
      "tier": "linked_native_evidence",
      "linked_accounting": true
    },
    {
      "id": "service_uid_isolation",
      "tier": "security",
      "reason": "Distinct non-root UIDs/mounts unavailable in this executor; remains G1"
    },
    {
      "id": "real_queue_and_api_bypass",
      "tier": "integration",
      "reason": "Real RQ lifecycle/mutation/direct endpoint closure unimplemented; remains G2"
    },
    {
      "id": "wms_ui_native_e2e",
      "tier": "integration",
      "reason": "Full current WMS UI/native bundle parent/dispatch/cancel races unimplemented; remains G3"
    },
    {
      "id": "dutch_accountant_signoff",
      "tier": "fiscal_review",
      "reason": "Qualified accountant has not reviewed/signed policy; remains G4"
    },
    {
      "id": "fresh_full_engine_build_upgrade",
      "tier": "operations",
      "reason": "Fresh complete ERPNext asset/framework/business-schema and restore/load acceptance not implemented; remains G5"
    },
    {
      "id": "live_integrations",
      "tier": "live",
      "reason": "No authorized live bank/tax/bol/Peppol mutation or live acceptance environment"
    }
  ],
  "not_applicable": {}
